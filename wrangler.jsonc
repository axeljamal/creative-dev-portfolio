{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creative-dev-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // axelle.marea-dvipa.uk; the workers.dev address stays on so older links keep working
  "routes": [{ "pattern": "axelle.marea-dvipa.uk", "custom_domain": true }],
  "workers_dev": true,

  // the built Vite site; /api/* goes to the Worker first
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creative-dev-portfolio",
      "database_id": "eeca63c3-cad5-4c4f-aed5-6afb33f52e69",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Cloudflare Access: your team domain, e.g. "axeljamal.cloudflareaccess.com",
    // and the Application Audience (AUD) tag of the /admin application
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // where new-message alerts go; leave empty to turn alerts off
    "NOTIFY_EMAIL": "axeltaj@gmail.com"
  }

  // secrets (set with `npx wrangler secret put <NAME>`):
  //   TURNSTILE_SECRET_KEY  required
  //   RESEND_API_KEY        optional, for email alerts
}
