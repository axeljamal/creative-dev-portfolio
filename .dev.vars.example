# copy to .dev.vars for local development (never commit .dev.vars)
# Turnstile's test secret: always passes
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=
# lets you open /admin locally without Cloudflare Access; only works on localhost
ADMIN_DEV_BYPASS=true
# or open /admin with a token, as in production
ADMIN_TOKEN=

# the helmsman (/api/ask) on a laptop: ask a local Ollama model instead of Workers AI (run `ollama serve` first)
HELMSMAN_LLM=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
