{
  "name": "creative-dev-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply creative-dev-portfolio --local",
    "db:migrate": "wrangler d1 migrations apply creative-dev-portfolio --remote",
    "cf-typegen": "wrangler types --strict-vars=false",
    "build:ds": "vite build -c vite.lib.config.ts && tsc -p tsconfig.ds.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jose": "^6.2.13",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  },
  "module": "./dist-ds/index.js",
  "types": "./dist-ds/ds/index.d.ts"
}
